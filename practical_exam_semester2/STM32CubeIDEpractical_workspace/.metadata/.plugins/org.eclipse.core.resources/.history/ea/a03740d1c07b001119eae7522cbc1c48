/**
* @brief Function implementing the MonitorTask thread.
* @param argument: Not used
* @retval None
*/
/* USER CODE END Header_StartMonitorTask */
void StartMonitorTask(void *argument)
{
  /* USER CODE BEGIN StartMonitorTask */
  /* Infinite loop */
	  const osTimerAttr_t timer1_attributes = {
	    .name = "timer1"
	  };
	  const osTimerAttr_t timer2_attributes = {
	    .name = "timer2"
	  };

	  timer1Handle = osTimerNew(Timer1Callback,
	                            osTimerPeriodic,
	                            NULL,
	                            &timer1_attributes);

	  timer2Handle = osTimerNew(Timer2Callback,
	                            osTimerPeriodic,
	                            NULL,
	                            &timer2_attributes);

	  osTimerStart(timer1Handle, 1000);
	  osTimerStart(timer2Handle, 2000);

  for(;;)
  {
	    printf( "MonitorTask: timer1Count = %lu, timer2Count = %lu\r\n",
	            timer1Count,
	            timer2Count);

    osDelay(1000);
  }
  /* USER CODE END StartMonitorTask */
}

